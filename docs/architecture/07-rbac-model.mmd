    ORG["Organization policy"] --> PERMS
    RES["Resource"] --> SCOPES["Scope chain: self , class:<id> , org:<id> , platform"]
    PERMS --> PDP["Policy Decision Point (can?)"]
    SCOPES --> PDP
    PDP -->|allow/deny| ENF["Enforcement Points (app + domain)"]
    PDP -->|render hints only| UI